# LLM provider configuration (server-side only)
# Use "ollama" for a local Ollama server, "qwen" for Alibaba DashScope,
# or "openai-compatible" for any other hosted OpenAI-compatible endpoint.
LLM_PROVIDER=mock
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1:8b
# Optional second model for the end-of-interview critique. It runs separately
# from the interviewer, so the interviewer can use a large, slow model while the
# closing criticism uses a smaller, faster one. Falls back to LLM_MODEL when unset.
LLM_CRITIQUE_MODEL=
# Voice input in the interview UI runs on-device (browser Whisper via
# transformers.js) by default — no server, no quotas, no API keys. The first
# use downloads a small model into the browser's cache; afterwards it works
# offline.
#
# The optional server route /api/transcribe (only if you wire a client to it)
# can point at its own provider/endpoint, independent of the chat provider.
# Configure TRANSCRIPTION_MODEL for Ollama (e.g. ollama pull whisper), and set
# the *_BASE_URL overrides when transcription runs somewhere other than chat —
# e.g. chat on Ollama Cloud (LLM_BASE_URL=https://ollama.com/v1) and whisper on
# a local server (TRANSCRIPTION_BASE_URL=http://127.0.0.1:11434).
TRANSCRIPTION_MODEL=dimavz/whisper-tiny
TRANSCRIPTION_PROVIDER=ollama
TRANSCRIPTION_BASE_URL=http://127.0.0.1:11434
# TRANSCRIPTION_API_KEY=
# Latency threshold in milliseconds — alerts when LLM responses exceed this
LLM_LATENCY_THRESHOLD_MS=10000
ALLOWED_ORIGINS=http://localhost:3000
MONITORING_REQUIRE_AUTH=true
# Comma-separated email allowlist for the monitoring dashboard/API.
# Put the exact email used at /auth here, for example: you@gmail.com
MONITORING_ADMIN_EMAILS=
# Optional bearer token for uptime checks and server-to-server monitoring.
# Generate with PowerShell: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
MONITORING_TOKEN=
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Upstash Redis (server-side only)
REDIS_REST_URL=
REDIS_REST_TOKEN=
REQUIRE_REDIS=false

# Neon PostgreSQL and Object Storage (server-side only)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Authentication (server-side only; generate a long random value)
AUTH_SECRET=

# Optional Google OAuth (server-side only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
